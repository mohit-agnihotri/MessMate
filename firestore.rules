rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Security & Role Helpers ─────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // V-12 Fix: Require cryptographically verified email for Admin access
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true && request.auth.token.email != null && (
          request.auth.token.email == 'mohitagnihotri.dev@gmail.com' ||
          request.auth.token.email == 'mohit.developer@gmail.com' ||
          request.auth.token.email == 'admin@messmate.app' ||
          request.auth.token.email == 'agnihotrimohit185@gmail.com' ||
          request.auth.token.email == 'mohitagnihotri1320@gmail.com' ||
          request.auth.token.email == 'mohitagnihotri1305@gmail.com'
        ))
      );
    }

    function isMessOwner(messId) {
      return isAuthenticated() && messId != null && messId != '' && (
        exists(/databases/$(database)/documents/messes/$(messId)) &&
        get(/databases/$(database)/documents/messes/$(messId)).data.ownerId == request.auth.uid
      );
    }

    // ─── Global Dishes ────────────────────────────────────────────────
    match /global_dishes/{dishId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Messes ───────────────────────────────────────────────────────
    match /messes/{messId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        (request.auth.uid == request.resource.data.ownerId && 
         (!request.resource.data.keys().hasAny(['subscriptionStatus', 'isVerified', 'isFrozen']) || 
          request.resource.data.subscriptionStatus == 'trial_active')) || 
        isAdmin()
      );
      // V-07 & V-08 Fix: Mess owners cannot self-grant Lifetime VIP, cannot self-verify, cannot change rating/reviewCount directly
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == resource.data.ownerId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'subscriptionStatus', 'trialStartDate', 'trialExpiresAt', 'isFrozen', 
           'isVerified', 'rating', 'reviewCount', 'ownerId', 'messId'
         ])) ||
        // Allow enrolled students to update aggregate rating & reviewCount when submitting a review
        (
          get(/databases/$(database)/documents/students/$(request.auth.uid)).data.messId == messId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 0 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.reviewCount is number &&
          request.resource.data.reviewCount >= 0
        )
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());

      match /meal_plans/{planId} {
        allow read: if true;
        allow write: if isMessOwner(messId) || isAdmin();
      }

      match /extra_fees/{feeId} {
        allow read: if isAuthenticated();
        allow write: if isMessOwner(messId) || isAdmin();
      }

      match /dishes/{dishId} {
        allow read: if true;
        allow write: if isMessOwner(messId) || isAdmin();
      }

      match /weekly_templates/{templateId} {
        allow read: if isAuthenticated();
        allow write: if isMessOwner(messId) || isAdmin();
      }

      match /closed_slots/{slotId} {
        allow read: if isAuthenticated();
        allow write: if isMessOwner(messId) || isAdmin();
      }

      match /expenses/{expenseId} {
        allow read, write: if isMessOwner(messId) || isAdmin();
      }

      match /feedbacks/{feedbackId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == resource.data.studentId || 
          isMessOwner(messId) || 
          isAdmin()
        );
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.studentId
          && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.messId == messId
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        // V-16 Fix: Owners cannot delete negative feedbacks to whitewash ratings; allows delete on mess/account cleanup
        allow update: if isAuthenticated() && request.auth.uid == resource.data.studentId;
        allow delete: if isAdmin() || isMessOwner(messId) || (isAuthenticated() && request.auth.uid == resource.data.studentId);
      }

      match /dish_ratings/{ratingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() 
          && request.auth.uid == request.resource.data.studentId
          && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.messId == messId;
        allow update: if isAuthenticated() && request.auth.uid == resource.data.studentId;
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.studentId || isAdmin());
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() 
          && request.auth.uid == request.resource.data.studentId
          && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.messId == messId;
        allow update: if isAuthenticated() && request.auth.uid == resource.data.studentId;
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.studentId || isAdmin());
      }
    }

    // ─── Students ─────────────────────────────────────────────────────
    match /students/{studentId} {
      // V-06 Fix: Student can only read their own profile; Owner can only read students of their mess
      allow read: if isAuthenticated() && (
        request.auth.uid == studentId ||
        (resource != null && isMessOwner(resource.data.messId)) ||
        isAdmin()
      );
      // When applying, initial status must be pending
      allow create: if isAuthenticated() && request.auth.uid == studentId && request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'pending';
      // V-04 Fix: Students cannot self-approve status to 'active' or modify subscriptionEndDate
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && isMessOwner(resource.data.messId)) ||
        (
          request.auth.uid == studentId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionEndDate']) &&
          (
            // Normal profile & preference updates (status, messId, assignedPlanId untouched)
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'messId', 'assignedPlanId']) ||
            // Leaving mess
            (request.resource.data.status == 'left' && request.resource.data.messId == '') ||
            // Requesting to join or switch mess (strictly pending, zero chance of self-approval to active)
            (request.resource.data.status == 'pending' && (resource.data.status in ['pending', 'left'] || resource.data.messId == '' || resource.data.messId == null))
          )
        )
      );
      // Allow student to delete their own account under DPDP Act / GDPR, or Admin
      allow delete: if isAuthenticated() && (request.auth.uid == studentId || isAdmin());
    }

    // ─── Menus ────────────────────────────────────────────────────────
    match /menus/{menuId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isMessOwner(request.resource.data.messId) || isAdmin());
      allow update: if isAuthenticated() && (isMessOwner(resource.data.messId) || isAdmin()) && request.resource.data.messId == resource.data.messId;
      allow delete: if isAuthenticated() && (isMessOwner(resource.data.messId) || isAdmin());
    }

    // ─── Announcements ────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isMessOwner(request.resource.data.messId) || isAdmin());
      allow update: if isAuthenticated() && (isMessOwner(resource.data.messId) || isAdmin()) && request.resource.data.messId == resource.data.messId;
      allow delete: if isAuthenticated() && (isMessOwner(resource.data.messId) || isAdmin());
    }

    // ─── Meal Records ─────────────────────────────────────────────────
    match /meal_records/{recordId} {
      // V-06 Fix: Only the student and their mess owner can read meal records
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.studentId ||
        (resource.data.messId != null && isMessOwner(resource.data.messId)) ||
        isAdmin()
      );
      // V-03 Fix: Cost must be bounded (<= 500) and status must be valid
      allow create: if isAuthenticated() && (
        (
          request.auth.uid == request.resource.data.studentId &&
          get(/databases/$(database)/documents/students/$(request.auth.uid)).data.messId == request.resource.data.messId &&
          (!('cost' in request.resource.data) || (request.resource.data.cost is number && request.resource.data.cost >= 0 && request.resource.data.cost <= 500)) &&
          request.resource.data.status in ['absent_self', 'present', 'guest', 'absent_owner']
        ) ||
        isMessOwner(request.resource.data.messId) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && resource != null && (
        ((request.auth.uid == resource.data.studentId && resource.data.status != 'guest' && request.resource.data.status in ['absent_self', 'present']) ||
         isMessOwner(resource.data.messId) ||
         isAdmin())
      ) && request.resource.data.studentId == resource.data.studentId &&
         (!('cost' in request.resource.data) || (request.resource.data.cost is number && request.resource.data.cost >= 0 && request.resource.data.cost <= 500));
      // V-05 Fix: Student CANNOT delete guest meal records (anti eat-and-delete fraud)
      allow delete: if isAuthenticated() && resource != null && (
        (request.auth.uid == resource.data.studentId && resource.data.status != 'guest') ||
        isMessOwner(resource.data.messId) ||
        isAdmin()
      );
    }

    // ─── Leaves ───────────────────────────────────────────────────────
    match /leaves/{leaveId} {
      // V-06 Fix: Scoped strictly to student and their mess owner
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.studentId ||
        (resource.data.messId != null && isMessOwner(resource.data.messId)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        (
          request.auth.uid == request.resource.data.studentId &&
          get(/databases/$(database)/documents/students/$(request.auth.uid)).data.messId == request.resource.data.messId
        ) ||
        isMessOwner(request.resource.data.messId) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && resource != null && (
        request.auth.uid == resource.data.studentId ||
        isMessOwner(resource.data.messId) ||
        isAdmin()
      ) && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.studentId || isAdmin());
    }

    // ─── Bills ────────────────────────────────────────────────────────
    match /bills/{billId} {
      // V-06 Fix: Financial isolation - Student only reads own bill, Owner only reads mess bills
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.studentId ||
        (resource.data.messId != null && isMessOwner(resource.data.messId)) ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        (request.resource.data.messId != null && isMessOwner(request.resource.data.messId)) ||
        (resource != null && resource.data.messId != null && isMessOwner(resource.data.messId)) ||
        isAdmin()
      );
      // Allow mess owner or Admin to delete bills on mess closure / deletion
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.messId != null && isMessOwner(resource.data.messId))
      );
    }

    // ─── System Configuration & Admin Vault ───────────────────────────
    match /system_config/admin_vault {
      allow read, write: if isAdmin();
    }
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Support Tickets & Help Desk ──────────────────────────────────
    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
